{
  "description": "Inject the simpler-English rule as developer context at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/emit-rule.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
